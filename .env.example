APP_NAME=SmartTech
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8082

# host address and port the web server is published on (use a Tailscale IP to keep it private)
APP_BIND=0.0.0.0
APP_PORT=8082

# Container names and the database's host port; change both to run a second copy
# (e.g. a staging checkout) next to this one
CONTAINER_PREFIX=wtech
DB_HOST_PORT=5433

# On the public server only: also run the Tailscale Funnel sidecar
# (needs docker/tailscale/ts.env with TS_AUTHKEY=tskey-auth-...)
#COMPOSE_FILE=docker-compose.yml:docker-compose.tailscale.yml

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=wtech_laravel
DB_USERNAME=wtech
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# true behind HTTPS (production), so the cookies are never sent over plain HTTP
SESSION_SECURE_COOKIE=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

ADMIN_EMAIL=admin@eshop.sk
ADMIN_PASSWORD=123456789

# demo shop: author and profile links shown on About, Contact and in the footer (empty = hidden)
DEMO_AUTHOR="Ákos Kappel"
DEMO_GITHUB_URL=https://github.com/AkosKappel
DEMO_REPOSITORY_URL=https://github.com/AkosKappel/WTECH-Laravel
DEMO_LINKEDIN_URL=
DEMO_PORTFOLIO_URL=

# nightly demo reset: rebuilds the database and removes uploads (off unless enabled; deletes all data)
DEMO_RESET_ENABLED=false
DEMO_RESET_TIME=03:00
DEMO_RESET_TIMEZONE=Europe/Bratislava
